# Keep raw EXIOBASE concordance sources out of git, but allow the audit README.
!data/exiobase_concordance_sources/
data/exiobase_concordance_sources/*
!data/exiobase_concordance_sources/README.md

# VSCode / editor
.vscode/
.idea/

# Generated images at repo root (prefer storing outputs under outputs/ or figures/)
/*.png
/*.jpg
/*.jpeg

# temp
tmp/*

# accidental caches inside src/
src/data/

# macOS
.DS_Store


# EXIOBASE concordance source archives and generated concordance outputs.
# Keep raw licence-controlled source archives outside git.
data/exiobase_concordance_sources/exiobase_concordances.zip
data/exiobase_concordance_sources/Concordances.zip
data/exiobase_concordance_sources/Concordances/
data/exiobase_concordance_sources/*.zip

# Generated from the local EXIOBASE concordance archive by
# scripts/mappings/build_exiobase3_to_eurostat_iot_a64_mapping.py.
data/exiobase_concordance_sources/derived/exiobase_eurostat_iot_a64/*.csv
data/exiobase_concordance_sources/derived/exiobase_eurostat_iot_a64/*.json
data/exiobase_concordance_sources/derived/exiobase_eurostat_iot_a64/README.md
