# Allow only the audit-trail README in the EXIOBASE concordance source folder.
!data/exiobase_concordance_sources/
data/exiobase_concordance_sources/*
!data/exiobase_concordance_sources/README.md

# Allow EUROSTAT concordance source folder since it has open license.
!data/eurostat_concordance_sources/
!data/eurostat_concordance_sources/*.zip

outputs/
figures/

